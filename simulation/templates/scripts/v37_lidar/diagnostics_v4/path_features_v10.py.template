# -*- coding: utf-8 -*-
"""Candidate forward-path features, not recovered real L1 internals.
Path and pose must share a fixed metric frame. Full task path stays fixed.
No rolling/truncated path, crossings, reverse motion or branch selection.
"""
import numpy as np


class ForwardPath(object):
    def __init__(self, points):
        points = np.asarray(points, dtype=float)
        if points.ndim != 2 or points.shape[1] != 2 or len(points) < 2 or not np.isfinite(points).all():
            raise ValueError('expected finite Nx2 path, N >= 2')
        keep = np.r_[True, np.any(np.diff(points, axis=0) != 0., axis=1)]
        self.points = points[keep]
        if len(self.points) < 2:
            raise ValueError('path needs nonzero length')
        self.delta = np.diff(self.points, axis=0)
        self.lengths = np.sqrt((self.delta ** 2).sum(axis=1))
        self.arc = np.r_[0., np.cumsum(self.lengths)]

    def features(self, pose, lookahead):
        pose = np.asarray(pose, dtype=float)
        if pose.shape != (3,) or not np.isfinite(pose).all() or not np.isfinite(lookahead) or lookahead <= 0.:
            raise ValueError('expected finite (x,y,yaw) and positive supplied lookahead')
        offset = pose[:2] - self.points[:-1]
        fraction = np.clip((offset * self.delta).sum(axis=1) / self.lengths ** 2, 0., 1.)
        projections = self.points[:-1] + fraction[:, None] * self.delta
        # First segment wins exact ties, including shared vertices.
        index = int(np.argmin(((projections - pose[:2]) ** 2).sum(axis=1)))
        tangent = self.delta[index] / self.lengths[index]
        normal = np.array([-tangent[1], tangent[0]])
        e_y = float(np.dot(projections[index] - pose[:2], normal))
        error = np.arctan2(tangent[1], tangent[0]) - pose[2]
        e_psi = float(np.arctan2(np.sin(error), np.cos(error)))
        s = self.arc[index] + fraction[index] * self.lengths[index]
        # Signed circumcircle through three samples spaced 0.1m along arc.
        # Short paths use L/2. Endpoint windows shift inward, not padded.
        step = min(.1, self.arc[-1] / 2.)
        start = np.clip(s - step, 0., self.arc[-1] - 2. * step)
        samples = start + np.arange(3) * step
        xy = np.column_stack([np.interp(samples, self.arc, self.points[:, k]) for k in range(2)])
        a, b, c = xy[1] - xy[0], xy[2] - xy[1], xy[2] - xy[0]
        denominator = np.linalg.norm(a) * np.linalg.norm(b) * np.linalg.norm(c)
        curvature = 0. if denominator == 0. else 2. * (a[0] * b[1] - a[1] * b[0]) / denominator
        return dict(e_y=e_y, e_psi=e_psi, kappa=float(curvature),
                    ld=float(lookahead), progress=float(s / self.arc[-1]), direction=0)
