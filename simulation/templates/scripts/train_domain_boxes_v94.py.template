def mat(stage,name,c,emit=False):
    m=UsdShade.Material.Define(stage,'/World/V44Materials/'+name)
    s=UsdShade.Shader.Define(stage,str(m.GetPath())+'/Surface')
    s.CreateIdAttr('UsdPreviewSurface')
    s.CreateInput('diffuseColor',Sdf.ValueTypeNames.Color3f).Set(Gf.Vec3f(*c))
    s.CreateInput('roughness',Sdf.ValueTypeNames.Float).Set(.65)
    if emit: s.CreateInput('emissiveColor',Sdf.ValueTypeNames.Color3f).Set(Gf.Vec3f(*c))
    m.CreateSurfaceOutput().ConnectToSource(s.ConnectableAPI(),'surface')
    return m

def bind(prim,m): UsdShade.MaterialBindingAPI.Apply(prim).Bind(m)

def box(stage,name,pos,scale,m,move=False):
    SCENE_BOXES.append((name,pos[0],pos[1],scale[0],scale[1],0.,pos[2]-scale[2]/2,pos[2]+scale[2]/2))
    path='/World/V44Scene/'+name
    g=UsdGeom.Cube.Define(stage,path); g.CreateSizeAttr(1.)
    g.AddTranslateOp().Set(Gf.Vec3d(*pos)); g.AddScaleOp().Set(Gf.Vec3f(*scale))
    UsdPhysics.CollisionAPI.Apply(g.GetPrim())
    if move:
        UsdPhysics.RigidBodyAPI.Apply(g.GetPrim()).CreateKinematicEnabledAttr(True)
        UsdPhysics.MassAPI.Apply(g.GetPrim()).CreateMassAttr(1.)
    bind(g.GetPrim(),m)
    return path

def marker(stage,name,geo,m):
    prim=UsdGeom.Sphere.Define(stage,BASE+'/V44Visual/'+name); prim.CreateRadiusAttr(.035)
    prim.AddTranslateOp().Set(Gf.Vec3d(geo.x,geo.y,geo.z)); bind(prim.GetPrim(),m)

def rays_mesh(stage,name,m):
    g=UsdGeom.Mesh.Define(stage,'/World/V44Debug/'+name)
    g.CreateSubdivisionSchemeAttr('none'); g.CreateDoubleSidedAttr(True); bind(g.GetPrim(),m)
    return g

def read_pose(view):
    p,q=view.get_world_poses(); p=np.asarray(p)[0]; w,x,y,z=np.asarray(q)[0]
    if abs(float(x))>.02 or abs(float(y))>.02: raise RuntimeError('box raycaster requires near-planar vehicle pose')
    return (float(p[0]),float(p[1]),float(math.atan2(2*(w*z+x*y),1-2*(y*y+z*z)))),float(p[2])

def cast(query,geo,pose,base_z,mesh):
    raw=[]; base_hits=[]; raw_types={'hit':0,'miss':0,'self_occluded':0}; verts=[]
    for i in range(geo.n_rays):
        origin,direction=sensor_ray(geo,i,pose)
        origin=(origin[0],origin[1],origin[2]+base_z)
        hit=query.raycast_closest(Gf.Vec3f(*origin),Gf.Vec3f(*direction),geo.range_max)
        length=5.0; value=None
        if hit.get('hit',False):
            path=str(hit.get('rigidBody',hit.get('collision','')))
            if path.startswith('/LYH_LJR'):
                raw_types['self_occluded']+=1
                length=min(length,float(hit['distance']))
            else:
                value=float(hit['distance']); raw_types['hit']+=1
                length=min(length,value)
                p=hit['position']; base_hits.append(world_point_to_base(pose,(float(p[0]),float(p[1]))))
        else: raw_types['miss']+=1
        raw.append(value) # null is a synthetic no-return representation, not claimed real data
        if i%40==0:
            w=.006; dx,dy=direction[:2]; px,py=-dy*w,dx*w
            sx,sy,sz=origin; ex=sx+length*dx; ey=sy+length*dy; z=sz+.006
            verts.extend([Gf.Vec3f(sx+px,sy+py,z),Gf.Vec3f(sx-px,sy-py,z),Gf.Vec3f(ex-px,ey-py,z),Gf.Vec3f(ex+px,ey+py,z)])
    mesh.CreateFaceVertexCountsAttr([4]*(len(verts)//4))
    mesh.CreateFaceVertexIndicesAttr(list(range(len(verts))))
    mesh.CreatePointsAttr(Vt.Vec3fArray(verts))
    return {'frame_id':geo.frame_id,'angle_min':geo.angle_min,'angle_max':geo.angle_max,'angle_increment':geo.angle_increment,'range_min':geo.range_min,'range_max':geo.range_max,'ranges':raw,'counts':raw_types},base_hits

def fast_cast(query,geo,pose,bz,moving_xy,mesh,update_display=True):
    data=batch.trace(geo,pose,bz,moving_xy)
    # Re-check corner/tangent rays with PhysX. Empty/self classifications are
    # resolved from the actual collision query rather than a planar approximation.
    ox,oy,oz=data['origin']
    for i in batch.near_corner_indices(geo,pose,moving_xy):
        dx=float(data['dx'][i]); dy=float(data['dy'][i])
        hit=query.raycast_closest(Gf.Vec3f(ox,oy,oz),Gf.Vec3f(dx,dy,0.),geo.range_max)
        if not hit.get('hit',False):
            data['ids'][i]=-1; data['distance'][i]=geo.range_max; data['range'][i]=np.nan
        else:
            path=str(hit.get('rigidBody',hit.get('collision','')))
            data['distance'][i]=float(hit['distance'])
            if path.startswith('/LYH_LJR'):
                data['ids'][i]=len(batch.rectangles(moving_xy,pose))-1; data['range'][i]=np.nan
            else:
                data['ids'][i]=0; data['range'][i]=float(hit['distance'])
    valid=np.isfinite(data['range'])
    px=ox+data['distance'][valid]*data['dx'][valid]; py=oy+data['distance'][valid]*data['dy'][valid]
    cs,ss=math.cos(pose[2]),math.sin(pose[2]); ddx=px-pose[0]; ddy=py-pose[1]
    data['hit_xy']=np.column_stack((cs*ddx+ss*ddy,-ss*ddx+cs*ddy))
    self_id=len(batch.rectangles(moving_xy,pose))-1
    data['counts']={'hit':int(np.count_nonzero(valid)),'miss':int(np.count_nonzero(data['ids']<0)),'self_occluded':int(np.count_nonzero(data['ids']==self_id))}
    vals=data['range']; indices=data['ids']; lengths=data['distance']
    ox,oy,oz=data['origin']; verts=[]
    for i in range(0,geo.n_rays,40):
        dx=float(data['dx'][i]); dy=float(data['dy'][i]); dist=min(5.,float(lengths[i]))
        w=.006; px=-dy*w; py=dx*w; ex=ox+dist*dx; ey=oy+dist*dy; z=oz+.006
        verts.extend([Gf.Vec3f(ox+px,oy+py,z),Gf.Vec3f(ox-px,oy-py,z),Gf.Vec3f(ex-px,ey-py,z),Gf.Vec3f(ex+px,ey+py,z)])
    if update_display:
        mesh.CreateFaceVertexCountsAttr([4]*(len(verts)//4)); mesh.CreateFaceVertexIndicesAttr(list(range(len(verts)))); mesh.CreatePointsAttr(Vt.Vec3fArray(verts))
    raw=[float(x) if np.isfinite(x) else None for x in vals]
    record={'frame_id':geo.frame_id,'angle_min':geo.angle_min,'angle_max':geo.angle_max,'angle_increment':geo.angle_increment,'range_min':geo.range_min,'range_max':geo.range_max,'ranges':raw,'counts':data['counts']}
    return record,data['hit_xy']


def compare_fast_with_physx(query,geo,pose,bz,moving_xy,mesh):
    reference,_=cast(query,geo,pose,bz,mesh)
    accelerated,_=fast_cast(query,geo,pose,bz,moving_xy,mesh)
    missing=0; differences=[]; mismatch_indices=[]
    for i,(a,b) in enumerate(zip(reference['ranges'],accelerated['ranges'])):
        if (a is None)!=(b is None):
            missing+=1; mismatch_indices.append(i)
        elif a is not None:
            differences.append(abs(a-b))
    max_error=max(differences) if differences else 0.
    log('PHYSX_COMPARE',geo.frame_id,'rays=',geo.n_rays,'visibility_mismatch=',missing,'max_distance_error=',round(max_error,6),'examples=',mismatch_indices[:8])
    if missing!=0 or max_error>.003:
        raise RuntimeError('batch raycaster mismatch; refusing to use for this scene')


def draw_line(mesh,positions,width=.018):
    verts=[]
    for (x0,y0),(x1,y1) in zip(positions,positions[1:]):
        dx=x1-x0; dy=y1-y0; length=math.hypot(dx,dy)
        if length<1e-7: continue
        px=-dy/length*width; py=dx/length*width; z=.055
        verts.extend([Gf.Vec3f(x0+px,y0+py,z),Gf.Vec3f(x0-px,y0-py,z),Gf.Vec3f(x1-px,y1-py,z),Gf.Vec3f(x1+px,y1+py,z)])
    mesh.CreateFaceVertexCountsAttr([4]*(len(verts)//4)); mesh.CreateFaceVertexIndicesAttr(list(range(len(verts)))); mesh.CreatePointsAttr(Vt.Vec3fArray(verts))


def direct(query,origin,direction):
    return query.raycast_closest(Gf.Vec3f(*origin),Gf.Vec3f(*direction),50.)

def assert_face(query,name,origin,direction,axis,expected):
    hit=direct(query,origin,direction)
    if not hit.get('hit',False) or name not in str(hit.get('collision','')):
        raise RuntimeError('expected %s; got %s'%(name,hit))
    pos=hit['position']; error=abs(float(pos[axis])-expected)
    if error>.025: raise RuntimeError('%s face error %.4f'%(name,error))
    log('CHECK',name,'surface=',round(float(pos[axis]),4),'error=',round(error,4))

