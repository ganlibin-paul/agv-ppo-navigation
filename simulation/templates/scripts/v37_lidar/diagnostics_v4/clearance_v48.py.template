import math

import numpy as np



def polygon(cx,cy,w,h,yaw):

    c,s=math.cos(yaw),math.sin(yaw)

    return np.array([[cx+c*x-s*y,cy+s*x+c*y] for x,y in [(-w/2,-h/2),(w/2,-h/2),(w/2,h/2),(-w/2,h/2)]])



def separation(a,b):

    separated=False

    for poly in (a,b):

        for i in range(4):

            edge=poly[(i+1)%4]-poly[i];axis=np.array([-edge[1],edge[0]])

            pa=a@axis;pb=b@axis

            if max(pa)<min(pb) or max(pb)<min(pa):separated=True

    if not separated:return 0.

    best=float('inf')

    for points,edges in ((a,b),(b,a)):

        for p in points:

            for i in range(4):

                u=edges[i];v=edges[(i+1)%4]-u

                t=np.clip((p-u)@v/(v@v),0.,1.)

                best=min(best,float(np.linalg.norm(p-u-t*v)))

    return best



def clearance(pose,boxes):

    body=polygon(pose[0]+.0125*math.cos(pose[2]),pose[1]+.0125*math.sin(pose[2]),.975,.703,pose[2])

    return min(separation(body,polygon(b[1],b[2],b[3],b[4],b[5])) for b in boxes if b[0]!='robot_body')
